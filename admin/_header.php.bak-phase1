<?php
declare(strict_types=1);

/**
 * Starr Savers — /admin/_header.php
 * Shared admin layout (top bar + side/tab navigation). Every admin page does:
 *     $adminTitle = 'Orders'; $adminNav = 'orders';
 *     require __DIR__ . '/_header.php';   ...content...   require __DIR__ . '/_footer.php';
 * Includes the login guard, so an admin page can never render for a non-admin.
 */

require_once __DIR__ . '/../includes/helpers.php';

start_session();
$admin = require_admin();           // redirects to /account.php?admin=1 when not an admin
$storeName = (string) setting('store_name', 'Starr Savers');
$adminTitle = $adminTitle ?? 'Admin';
$adminNav   = $adminNav ?? '';

/** Redirects back (PRG pattern) after a POST, with an optional flash message. */
function admin_redirect(string $url, ?string $type = null, ?string $message = null): void
{
    if ($type !== null && $message !== null) { flash_set($type, $message); }
    header('Location: ' . $url);
    exit;
}

/** Call at the top of any admin POST handler. */
function admin_require_csrf(string $backTo): void
{
    if (!csrf_verify()) {
        admin_redirect($backTo, 'error', 'Your session expired. Please try again.');
    }
}

$flash = flash_get();
$assetVer = static function (string $path): string {
    $f = STARR_ROOT . $path;
    return $path . (is_file($f) ? '?v=' . filemtime($f) : '');
};
?>
